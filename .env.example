# Vercel / 로컬 공통 — 값만 넣고 파일명은 .env.local 로 복사해 사용하세요.
# https://vercel.com/docs/projects/environment-variables

# Supabase (필수: 사이트 데이터·미들웨어·데이터 분석 API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — AI 분석(/api/ask)·sync 스크립트 등. Vercel에는 반드시 추가(Production/Preview 모두).
SUPABASE_SERVICE_ROLE_KEY=
# Vercel 서버 런타임 URL(권장): `NEXT_PUBLIC_SUPABASE_URL`과 동일한 Project URL을 넣으면
# 서비스 롤 클라이언트가 항상 런타임 env에서 URL을 읽습니다(`fetch failed` 디버깅에 유리).
SUPABASE_URL=

# Google Gemini (데이터 분석 /api/ask — 없으면 해당 기능만 비활성)
GEMINI_API_KEY=
# 또는: GOOGLE_GENERATIVE_AI_API_KEY=

# 선택: 로컬 ngrok 등 추가 출처 (쉼표 구분)
# NEXT_ALLOWED_DEV_ORIGINS=
